# ============================================
# EPC 生产环境配置
# 复制为 .env 后修改
# ============================================

# ─── 域名 ─────────────────────────────────────
DOMAIN=your-domain.com
FRONTEND_HOST=https://dashboard.your-domain.com

# ─── 环境 ─────────────────────────────────────
ENVIRONMENT=production
PROJECT_NAME="The Education of the Child"
STACK_NAME=epc

# ─── 后端安全 ──────────────────────────────────
# 生成方式：openssl rand -hex 32
SECRET_KEY=
BACKEND_CORS_ORIGINS="https://dashboard.your-domain.com"

# ─── Docker 镜像 ───────────────────────────────
DOCKER_IMAGE_BACKEND=ghcr.io/YOUR_USERNAME/epc-backend
DOCKER_IMAGE_FRONTEND=ghcr.io/YOUR_USERNAME/epc-frontend
TAG=latest

# ─── 管理员账户 ─────────────────────────────────
FIRST_SUPERUSER=admin@your-domain.com
FIRST_SUPERUSER_PASSWORD=

# ─── 邮件服务 ───────────────────────────────────
# 阿里云邮件推送 / SendGrid / 任意 SMTP
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@your-domain.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=465

# ─── PostgreSQL ────────────────────────────────
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=epc
POSTGRES_USER=epc_user
POSTGRES_PASSWORD=

# ─── Casdoor ────────────────────────────────────
CASDOOR_DB_PASSWORD=

# ─── 监控（可选） ───────────────────────────────
SENTRY_DSN=
